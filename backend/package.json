    "start": "node dist/index.js"
  },
  "dependencies": {
    "@rimvio/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
